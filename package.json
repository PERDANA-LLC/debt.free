{
  "name": "debtfree",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.21",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "stripe": "^23.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vercel": "^66.6.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}